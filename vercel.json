{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...route].js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index?path=$1"
    }
  ]
}