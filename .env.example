# Copy these into Vercel → Project → Settings → Environment Variables.
# Do not commit real values to GitHub.
DATABASE_URL=postgresql://YOUR_NEON_CONNECTION_STRING
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://YOUR-PROJECT.vercel.app
APP_ORIGIN=https://YOUR-PROJECT.vercel.app

# Replace these examples with real approved addresses.
# Multiple addresses: comma-separated.
MENTOR_EMAILS=mentor@example.com
STUDENT_EMAILS=student@example.com

# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
